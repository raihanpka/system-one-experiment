{
  "domain": "insurance + finance",
  "sources": [
    {"id": "policy_number", "type": "string", "desc": "Unique identifier of the insurance policy", "gen": ["id", "POL-", 8], "names": {"2": "pol_no", "3": "contract_ref", "4": "nomor_polis", "5": "COV_UNIQ_KEY"}},
    {"id": "holder_first_name", "type": "string", "desc": "Given name of the policy holder", "gen": ["pick", ["Budi", "Siti", "Agus", "Dewi", "Rina", "Andi", "Maya", "Joko"]], "names": {"2": "fname", "3": "given_name", "4": "nama_depan", "5": "PRTY_NM_1"}},
    {"id": "holder_last_name", "type": "string", "desc": "Family name of the policy holder", "gen": ["pick", ["Santoso", "Wijaya", "Pratama", "Lestari", "Hidayat", "Kusuma", "Nasution", "Putri"]], "names": {"2": "lname", "3": "surname", "4": "nama_belakang", "5": "PRTY_NM_2"}},
    {"id": "insured_birth_date", "type": "date", "desc": "Date of birth of the insured person", "gen": ["date", "1950-01-01", "2005-12-31"], "names": {"2": "dob", "3": "born_on", "4": "tgl_lahir", "5": "PRTY_DT_A"}},
    {"id": "insured_gender", "type": "string", "desc": "Gender of the insured person (M or F)", "gen": ["pick", ["M", "F"]], "names": {"2": "gndr", "3": "sex", "4": "jenis_kelamin", "5": "PRTY_CAT_B"}},
    {"id": "coverage_start_date", "type": "date", "desc": "First day the policy covers risk", "gen": ["date", "2024-01-01", "2024-12-31"], "names": {"2": "pol_st_dt", "3": "effective_date", "4": "tgl_mulai_polis", "5": "PERIOD_FROM_X"}},
    {"id": "coverage_end_date", "type": "date", "desc": "Last day the policy covers risk", "gen": ["date", "2025-07-01", "2026-12-31"], "names": {"2": "pol_end_dt", "3": "expiry_date", "4": "tgl_akhir_polis", "5": "PERIOD_TO_X"}},
    {"id": "sum_insured_amount", "type": "number", "desc": "Maximum amount the insurer pays out under the policy", "gen": ["money", 50000000, 2000000000], "names": {"2": "sum_ins", "3": "cover_limit", "4": "uang_pertanggungan", "5": "LMT_VAL_MAX"}},
    {"id": "base_premium", "type": "number", "desc": "Premium before tax and discount", "gen": ["money", 1000000, 20000000], "names": {"2": "prem_base", "3": "base_charge", "4": "premi_dasar", "5": "CHG_AMT_RAW"}},
    {"id": "premium_tax_rate", "type": "number", "desc": "Tax rate applied to the premium, as a fraction (0.11 = 11 percent)", "gen": ["rate", 0.0, 0.2, 2], "names": {"2": "prem_tax_pct", "3": "levy_rate", "4": "persen_pajak_premi", "5": "CHG_LVY_PCT"}},
    {"id": "discount_rate", "type": "number", "desc": "Discount given on the premium, as a fraction", "gen": ["rate", 0.0, 0.3, 2], "names": {"2": "disc_pct", "3": "rebate_rate", "4": "persen_diskon", "5": "CHG_RBT_PCT"}},
    {"id": "currency_code", "type": "string", "desc": "ISO currency code of all monetary amounts", "gen": ["pick", ["IDR", "USD", "SGD"]], "names": {"2": "ccy", "3": "money_unit", "4": "mata_uang", "5": "VAL_UNIT_CD"}},
    {"id": "claim_number", "type": "string", "desc": "Unique identifier of the claim", "gen": ["id", "CLM-", 7], "names": {"2": "clm_no", "3": "case_ref", "4": "nomor_klaim", "5": "EVT_CASE_KEY"}},
    {"id": "claim_incident_date", "type": "date", "desc": "Date the insured event happened", "gen": ["date", "2025-01-01", "2025-06-30"], "names": {"2": "clm_dt", "3": "loss_date", "4": "tgl_kejadian", "5": "EVT_DT_LOSS"}},
    {"id": "claimed_amount", "type": "number", "desc": "Amount requested by the claimant", "gen": ["money", 5000000, 100000000], "names": {"2": "clm_amt", "3": "requested_payout", "4": "jumlah_klaim", "5": "EVT_AMT_REQ"}},
    {"id": "deductible_amount", "type": "number", "desc": "Part of the loss the insured pays themselves", "gen": ["money", 100000, 1000000], "names": {"2": "ded", "3": "excess", "4": "risiko_sendiri", "5": "EVT_AMT_SELF"}},
    {"id": "claim_paid_amount", "type": "number", "desc": "Amount already paid out on the claim", "gen": ["money", 1000000, 90000000], "names": {"2": "paid_amt", "3": "settled_sum", "4": "jumlah_dibayar", "5": "EVT_AMT_DONE"}},
    {"id": "claim_status_code", "type": "string", "desc": "One-letter claim status: A approved, R rejected, P pending", "gen": ["pick", ["A", "R", "P"]], "names": {"2": "clm_stat", "3": "case_state", "4": "kode_status_klaim", "5": "EVT_PHS_CD"}},
    {"id": "insured_city", "type": "string", "desc": "City where the insured lives", "gen": ["pick", ["Jakarta", "Bandung", "Surabaya", "Medan", "Semarang", "Makassar"]], "names": {"2": "cty", "3": "town", "4": "kota", "5": "OBJ_INFO_ADDR_C"}},
    {"id": "insured_province", "type": "string", "desc": "Province where the insured lives", "gen": ["pick", ["DKI Jakarta", "Jawa Barat", "Jawa Timur", "Sumatera Utara", "Jawa Tengah", "Sulawesi Selatan"]], "names": {"2": "prov", "3": "state_region", "4": "provinsi", "5": "OBJ_INFO_ADDR_P"}},
    {"id": "postal_code", "type": "string", "desc": "Postal code of the insured address", "gen": ["id", "", 5], "names": {"2": "pcode", "3": "zip", "4": "kode_pos", "5": "OBJ_INFO_ADDR_Z"}},
    {"id": "agent_id", "type": "string", "desc": "Identifier of the selling agent", "gen": ["id", "AGT", 5], "names": {"2": "agt_cd", "3": "broker_id", "4": "kode_agen", "5": "SLS_CHNL_KEY"}},
    {"id": "account_number", "type": "string", "desc": "Bank or ledger account number of the customer", "gen": ["id", "", 10], "names": {"2": "acct_no", "3": "ledger_ref", "4": "nomor_rekening", "5": "LDG_OWNR_KEY"}},
    {"id": "transaction_date", "type": "date", "desc": "Date the transaction was booked", "gen": ["date", "2025-01-01", "2025-12-31"], "names": {"2": "txn_dt", "3": "posting_date", "4": "tgl_transaksi", "5": "MVT_DT_POST"}},
    {"id": "transaction_amount", "type": "number", "desc": "Amount of money moved by the transaction", "gen": ["money", 50000, 50000000], "names": {"2": "txn_amt", "3": "movement_value", "4": "nominal_transaksi", "5": "MVT_AMT_MAIN"}},
    {"id": "transaction_fee_amount", "type": "number", "desc": "Fee charged on the transaction", "gen": ["money", 1000, 50000], "names": {"2": "fee_amt", "3": "service_charge", "4": "biaya_admin", "5": "MVT_AMT_SVC"}}
  ],
  "decoys": [
    {"id": "agent_commission_amount", "type": "number", "desc": "Commission paid to the agent", "gen": ["money", 50000, 2000000]},
    {"id": "adjuster_name", "type": "string", "desc": "Name of the claims adjuster", "gen": ["pick", ["Eko", "Tono", "Lia"]]},
    {"id": "policy_version", "type": "string", "desc": "Version counter of the policy record", "gen": ["id", "v", 2]},
    {"id": "premium_receipt_date", "type": "date", "desc": "Date the premium payment was received", "gen": ["date", "2024-01-01", "2024-12-31"]},
    {"id": "internal_remark", "type": "string", "desc": "Free-text internal note", "gen": ["pick", ["checked", "call back", "vip"]]},
    {"id": "record_hash", "type": "string", "desc": "Technical hash of the source row", "gen": ["id", "h", 12]}
  ],
  "outputs": [
    {"name": "policy_number", "kind": "pass", "type": "string", "description": "Official policy identifier", "rule": {"src": "policy_number"}},
    {"name": "insured_full_name", "kind": "concat", "type": "string", "description": "Full name of the insured, given name then family name", "rule": {"op": "concat", "sep": " ", "args": [{"src": "holder_first_name"}, {"src": "holder_last_name"}]}},
    {"name": "insured_birth_date", "kind": "pass", "type": "date", "description": "Date of birth of the insured", "rule": {"src": "insured_birth_date"}},
    {"name": "insured_birth_year", "kind": "format", "type": "number", "description": "Year of birth of the insured", "rule": {"op": "year", "args": [{"src": "insured_birth_date"}]}},
    {"name": "insured_gender", "kind": "pass", "type": "string", "description": "Gender of the insured", "rule": {"src": "insured_gender"}},
    {"name": "insured_city", "kind": "pass", "type": "string", "description": "City of the insured address", "rule": {"src": "insured_city"}},
    {"name": "insured_province", "kind": "pass", "type": "string", "description": "Province of the insured address", "rule": {"src": "insured_province"}},
    {"name": "postal_code", "kind": "pass", "type": "string", "description": "Postal code of the insured address", "rule": {"src": "postal_code"}},
    {"name": "insured_address", "kind": "concat", "type": "string", "description": "Single-line address: city, province postal code", "rule": {"op": "concat", "sep": " ", "args": [{"op": "concat", "sep": ", ", "args": [{"src": "insured_city"}, {"src": "insured_province"}]}, {"src": "postal_code"}]}},
    {"name": "coverage_start_date", "kind": "pass", "type": "date", "description": "Date coverage begins", "rule": {"src": "coverage_start_date"}},
    {"name": "coverage_end_date", "kind": "pass", "type": "date", "description": "Date coverage ends", "rule": {"src": "coverage_end_date"}},
    {"name": "coverage_days", "kind": "arith", "type": "number", "description": "Number of days between coverage start and coverage end", "rule": {"op": "days_between", "args": [{"src": "coverage_start_date"}, {"src": "coverage_end_date"}]}},
    {"name": "sum_insured_amount", "kind": "pass", "type": "number", "description": "Maximum payout under the policy", "rule": {"src": "sum_insured_amount"}},
    {"name": "currency_code", "kind": "pass", "type": "string", "description": "Currency of all amounts", "rule": {"src": "currency_code"}},
    {"name": "gross_premium", "kind": "arith", "type": "number", "description": "Base premium plus tax: base premium times (1 + tax rate)", "rule": {"op": "mul", "args": [{"src": "base_premium"}, {"op": "add", "args": [{"lit": 1}, {"src": "premium_tax_rate"}]}]}},
    {"name": "net_premium_after_discount", "kind": "arith", "type": "number", "description": "Base premium after discount: base premium times (1 - discount rate)", "rule": {"op": "mul", "args": [{"src": "base_premium"}, {"op": "sub", "args": [{"lit": 1}, {"src": "discount_rate"}]}]}},
    {"name": "claim_number", "kind": "pass", "type": "string", "description": "Official claim identifier", "rule": {"src": "claim_number"}},
    {"name": "claim_incident_date", "kind": "pass", "type": "date", "description": "Date of the insured event", "rule": {"src": "claim_incident_date"}},
    {"name": "claim_age_days", "kind": "arith", "type": "number", "description": "Days from coverage start to the incident", "rule": {"op": "days_between", "args": [{"src": "coverage_start_date"}, {"src": "claim_incident_date"}]}},
    {"name": "claimed_amount", "kind": "pass", "type": "number", "description": "Amount requested in the claim", "rule": {"src": "claimed_amount"}},
    {"name": "deductible_amount", "kind": "pass", "type": "number", "description": "Deductible borne by the insured", "rule": {"src": "deductible_amount"}},
    {"name": "net_claim_payable", "kind": "arith", "type": "number", "description": "Claimed amount minus deductible", "rule": {"op": "sub", "args": [{"src": "claimed_amount"}, {"src": "deductible_amount"}]}},
    {"name": "claim_paid_amount", "kind": "pass", "type": "number", "description": "Amount already paid on the claim", "rule": {"src": "claim_paid_amount"}},
    {"name": "claim_paid_ratio", "kind": "arith", "type": "number", "description": "Paid amount divided by base premium", "rule": {"op": "div", "args": [{"src": "claim_paid_amount"}, {"src": "base_premium"}]}},
    {"name": "claim_status", "kind": "lookup", "type": "string", "description": "Claim status in words (Approved, Rejected, Pending)", "rule": {"op": "lookup", "map": {"A": "Approved", "R": "Rejected", "P": "Pending"}, "args": [{"src": "claim_status_code"}]}},
    {"name": "agent_id", "kind": "pass", "type": "string", "description": "Selling agent identifier", "rule": {"src": "agent_id"}},
    {"name": "account_number", "kind": "pass", "type": "string", "description": "Customer account number", "rule": {"src": "account_number"}},
    {"name": "transaction_date", "kind": "pass", "type": "date", "description": "Booking date of the transaction", "rule": {"src": "transaction_date"}},
    {"name": "transaction_amount", "kind": "pass", "type": "number", "description": "Transaction amount", "rule": {"src": "transaction_amount"}},
    {"name": "transaction_fee_amount", "kind": "pass", "type": "number", "description": "Fee charged on the transaction", "rule": {"src": "transaction_fee_amount"}},
    {"name": "total_charge", "kind": "arith", "type": "number", "description": "Transaction amount plus fee", "rule": {"op": "add", "args": [{"src": "transaction_amount"}, {"src": "transaction_fee_amount"}]}}
  ]
}
