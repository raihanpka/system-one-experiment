{
  "OpenRouter": {
    "Model": "~liquid/d1-ultra-latest",
    "BaseUrl": "https://openrouter.ai/api/alpha/decisions",
    "ApiKeyEnv": "OPENROUTER_API_KEY"
  },
  "Run": {
    "KeepD": 0.0,
    "TargetPrecision": 0.9,
    "PromptVersion": "v1",
    "Mode": "options",
    "Seed": 1234,
    "Conds": ["name", "samples"]
  },
  "Splits": {
    "Dev": [11],
    "Calibration": [12, 13],
    "Test": [21, 22]
  }
}
