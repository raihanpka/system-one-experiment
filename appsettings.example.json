{
  "Backend": {
    "Type": "openrouter"
  },
  "OpenRouter": {
    "Model": "~liquid/d1-ultra-latest",
    "BaseUrl": "https://openrouter.ai/api/alpha/decisions",
    "ApiKeyEnv": "OPENROUTER_API_KEY"
  },
  "Local": {
    "Quant": "Q8_0",
    "Ngl": 999,
    "FlashAttn": "default",
    "Threads": 8
  },
  "Device": {
    "Mode": "auto"
  },
  "Run": {
    "KeepD": 0.0,
    "TargetPrecision": 1.0,
    "PromptVersion": "v1",
    "Mode": "options",
    "Seed": 1234,
    "Conds": ["name", "samples"]
  },
  "Splits": {
    "Dev": [11],
    "Calibration": [12, 13],
    "Test": [21, 22]
  }
}
